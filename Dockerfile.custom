# Custom overlay: add your tools on top of the base openclaw image.
# Build:
#   docker build -t openclaw:local -f Dockerfile .
#   docker build -t openclaw:custom -f Dockerfile.custom .
# Run:
#   OPENCLAW_IMAGE=openclaw:custom ./scripts/docker/setup.sh

FROM openclaw:local

USER root

# GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

# ffmpeg for audio/video transcription
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Claude Code CLI (required for ACPX claude agent)
RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force

# Python + uv (required for spec-kit / specify CLI)
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

# Custom entrypoint: seeds spec-kit skills and agent workspace on startup
COPY scripts/docker/entrypoint-custom.sh /usr/local/bin/entrypoint-custom.sh
RUN chmod +x /usr/local/bin/entrypoint-custom.sh

# Add more tools below as needed, e.g.:
# RUN apt-get update && apt-get install -y --no-install-recommends ripgrep && rm -rf /var/lib/apt/lists/*

USER node

# Install uv + spec-kit (specify CLI) as non-root user
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/node/.local/bin:${PATH}"
RUN uv tool install specify-cli --from git+https://github.com/github/spec-kit.git

# Pre-scaffold spec-kit Claude Code skills into a staging directory.
# The entrypoint copies these into the Claude credentials volume at startup.
RUN mkdir -p /tmp/speckit-init && \
    cd /tmp/speckit-init && \
    echo "y" | specify init . --ai claude --here 2>/dev/null && \
    mkdir -p /opt/speckit-skills && \
    cp -r .claude/skills/* /opt/speckit-skills/ && \
    rm -rf /tmp/speckit-init

# Stage speckit agent workspace template (AGENTS.md with spec-kit instructions)
COPY scripts/docker/speckit-workspace/ /opt/speckit-workspace/

ENTRYPOINT ["/usr/local/bin/entrypoint-custom.sh"]
